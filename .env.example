# Copy to .env (gitignored). The library reads these from the environment; the API also loads .env.
PPLX_DECIDER_URL=https://<workspace>--pplx-decider-serve.us-east.modal.run
PPLX_DECIDER_API_KEY=
# System 2 through the Anthropic API. Leave unset to use the local `claude` CLI instead.
ANTHROPIC_API_KEY=
# Bearer token callers must send to the HTTP API.
SYSTEM1_API_KEY=
# Confidence below which a question goes to System 2.
SYSTEM1_THRESHOLD=0.8
