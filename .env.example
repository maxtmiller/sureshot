# Copy to .env (gitignored). The library reads these from the environment; the API also loads .env.
# System 1: any chat-completions endpoint that returns logprobs (OpenAI, vLLM, Ollama, Together, Groq...).
# SURESHOT_SYSTEM1=chat   # or vllm for a model you serve with vLLM (see README)
SURESHOT_SYSTEM1_MODEL=
SURESHOT_SYSTEM1_URL=http://localhost:8000/v1
SURESHOT_SYSTEM1_API_KEY=
# Optional JSON merged into every request, e.g. {"reasoning_effort": "none"} for a model that thinks before answering.
# SURESHOT_SYSTEM1_EXTRA=
# System 2: auto (default: Claude API if ANTHROPIC_API_KEY is set, else the local claude CLI), claude, claude-cli, chat or none.
# System 2 through the Anthropic API. Leave unset to use the local `claude` CLI instead.
ANTHROPIC_API_KEY=
# SURESHOT_SYSTEM2=auto
# SURESHOT_SYSTEM2_MODEL=
# Bearer token callers must send to the HTTP API.
SURESHOT_API_KEY=
# Confidence below which a question goes to System 2.
SURESHOT_THRESHOLD=0.8
# SQLite log of decisions, enabling /feedback and /calibrate. Unset to disable.
# SURESHOT_DB=sureshot.db
# Share of confident questions also checked by System 2, so calibration sees every confidence level.
# SURESHOT_AUDIT=0.1
# Response cache: reuse a model's answer to the same question about the same text. TTL is in seconds.
# SURESHOT_CACHE=cache.db
# SURESHOT_CACHE_TTL=604800
